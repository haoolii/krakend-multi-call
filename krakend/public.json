{
  "$schema": "https://www.krakend.io/schema/v2.13/krakend.json",
  "version": 3,
  "name": "all-fabs-settings-public",
  "port": 8080,
  "timeout": "60s",
  "cache_ttl": "0s",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND-PUBLIC]",
      "syslog": false,
      "stdout": true
    },
    "telemetry/opentelemetry": {
      "service_name": "krakend-all-fabs",
      "service_version": "1.0.0",
      "deploy_env": "poc",
      "trace_sample_rate": 1,
      "exporters": {
        "prometheus": [
          {
            "name": "krakend_public",
            "port": 9091,
            "listen_ip": "0.0.0.0",
            "process_metrics": true,
            "go_metrics": true
          }
        ],
        "otlp": [
          {
            "name": "local_collector",
            "host": "otel-collector",
            "port": 4318,
            "use_http": true,
            "disable_metrics": true
          }
        ]
      },
      "layers": {
        "global": {
          "disable_metrics": false,
          "disable_traces": false
        },
        "proxy": {
          "disable_metrics": false,
          "disable_traces": false
        },
        "backend": {
          "metrics": {
            "disable_stage": false,
            "round_trip": true,
            "read_payload": true
          },
          "traces": {
            "disable_stage": false,
            "round_trip": true,
            "read_payload": true
          }
        }
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/allfabs-settings",
      "method": "GET",
      "output_encoding": "json",
      "timeout": "60s",
      "extra_config": {
        "modifier/lua-proxy": {
          "sources": ["/etc/krakend/response.lua"],
          "allow_open_libs": true,
          "post": "format_all_fabs_response(response.load())"
        }
      },
      "backend": [
        {
          "host": ["http://krakend-aggregator:8080"],
          "url_pattern": "/internal/allfabs-settings",
          "encoding": "json"
        }
      ]
    }
  ]
}
