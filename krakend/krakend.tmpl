{
  "$schema": "https://www.krakend.io/schema/v2.13/krakend.json",
  "version": 3,
  "name": "parallel-fab-lua-transform-poc",
  "port": 8080,
  "timeout": "{{ .fabs.endpoint_timeout }}",
  "response_header_timeout": "{{ .fabs.response_header_timeout }}",
  "cache_ttl": "0s",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "telemetry/opentelemetry": {
      "service_name": "krakend-permission-fanout",
      "service_version": "1.0.0",
      "deploy_env": "poc",
      "trace_sample_rate": 1,
      "exporters": {
        "prometheus": [
          {
            "name": "krakend",
            "port": 9091,
            "listen_ip": "0.0.0.0",
            "process_metrics": true,
            "go_metrics": true
          }
        ],
        "otlp": [
          {
            "name": "local_collector",
            "host": "otel-collector",
            "port": 4318,
            "use_http": true,
            "disable_metrics": true
          }
        ]
      },
      "layers": {
        "global": { "disable_metrics": false, "disable_traces": false },
        "proxy": { "disable_metrics": false, "disable_traces": false },
        "backend": {
          "metrics": { "disable_stage": false, "round_trip": true, "read_payload": true },
          "traces": { "disable_stage": false, "round_trip": true, "read_payload": true }
        }
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/allfabs",
      "method": "POST",
      "input_headers": ["X-Request-Id", "X-Internal-Skip-Fabs"],
      "output_encoding": "json",
      "timeout": "{{ .fabs.endpoint_timeout }}",
      "extra_config": {
        "modifier/lua-endpoint": {
          "sources": ["/etc/krakend/request.lua"],
          "allow_open_libs": true,
          "pre": "prepare_skip_fabs()"
        },
        "proxy": {
          "static": {
            "strategy": "always",
            "data": {
              "callFabs": [{{ range $index, $fab := .fabs.fabs }}{{ if $index }}, {{ end }}"{{ $fab }}"{{ end }}]
            }
          }
        }
      },
      "backend": [
        {{ range $index, $fab := .fabs.fabs }}
        {{ if $index }},{{ end }}
        {
          "group": "{{ $fab }}",
          "method": "GET",
          "host": ["{{ $.fabs.endpoint }}"],
          "url_pattern": "/fabs/{{ $fab }}/settings",
          "encoding": "json",
          "is_collection": true,
          "extra_config": {
            "backend/http": {
                "return_error_details": "{{ $fab }}"
            },
            "validation/cel": [
              {
                "check_expr": "!('X-Internal-Skip-Fabs' in req_headers) || !(',' + req_headers['X-Internal-Skip-Fabs'][0] + ',').contains(',{{ $fab }},')"
              }
            ],
            "modifier/lua-backend": {
              "sources": ["/etc/krakend/response.lua"],
              "allow_open_libs": true,
              "post": "remove_page_field(response.load(), '{{ $fab }}')"
            }
          }
        }
        {{ end }}
      ]
    }
  ]
}
